{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "Ninja",
      "description": "Ninja generator",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/thirdparty/vcpkg"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configuration": "Debug",
      "configurePreset": "Ninja"
    },
    {
      "name": "RelWithDbgInfo",
      "configuration": "RelWithDebInfo",
      "configurePreset": "Ninja"
    },
    {
      "name": "Release",
      "configuration": "Release",
      "configurePreset": "Ninja"
    }
  ],
  "packagePresets": [
    {
      "name": "default",
      "configurePreset": "Ninja",
      "generators": ["TGZ"]
    }
  ],
  "workflowPresets": [
    {
      "name": "Debug",
      "steps": [
        {
          "type": "configure",
          "name": "Ninja"
        },
        {
          "type": "build",
          "name": "Debug"
        },
        {
          "type": "package",
          "name": "default"
        }
      ]
    },
    {
      "name": "RelWithDbgInfo",
      "steps": [
        {
          "type": "configure",
          "name": "Ninja"
        },
        {
          "type": "build",
          "name": "RelWithDbgInfo"
        },
        {
          "type": "package",
          "name": "default"
        }
      ]
    },
    {
      "name": "Release",
      "steps": [
        {
          "type": "configure",
          "name": "Ninja"
        },
        {
          "type": "build",
          "name": "Release"
        },
        {
          "type": "package",
          "name": "default"
        }
      ]
    }
  ]
}
